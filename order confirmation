{{#partial "head"}}

{{{ checkout.checkout_head }}}
{{{ stylesheet '/assets/css/optimized-checkout.css' }}}
{{ getFontsCollection }}

<script type="text/javascript">
    window.language = {{{langJson 'optimized_checkout'}}};
</script>

{{!-- START OLS CUSTOMIZATION - Windows Object - Checkout Success --}}
{{> _ols/components/window-object/ols-window-checkout-success }}
{{!-- END OLS CUSTOMIZATION --}}

{{!-- START OLS CUSTOMIZATION - Google Datalayer - Order Confirmation --}}
{{> _ols/components/integrations/google/ols-google-datalayer }}
{{!-- END OLS CUSTOMIZATION --}}

{{!-- START OLS CUSTOMIZATION - Feature - Custom Checkout Success Script Integration --}}
<script async src="{{cdn 'assets/dist/theme-bundle.checkout_success.js'}}"></script>
{{!-- END OLS CUSTOMIZATION --}}

{{!-- START OLS CUSTOMIZATION - Feature - Sitejabber - Instant Feedback Widget --}}
{{> _ols/components/integrations/sitejabber/ols-sitejabber-instantfeedback}}
{{!-- END OLS CUSTOMIZATION --}}

{{{head.scripts}}}

{{/partial}}

{{#partial "page"}}
    {{!-- START OLS CUSTOMIZATION - Feature - Kount - Order Confirmation --}}
    {{> _ols/components/ols-kount-iframe }}
    {{!-- END OLS CUSTOMIZATION --}}

    {{!-- START OLS CUSTOMIZATION - Feature - Google Tag Manager - Order Confirmation - [GMT] --}}
    {{> _ols/components/integrations/google/ols-google-tag-manager }}
    {{!-- END OLS CUSTOMIZATION --}}

    <header class="checkoutHeader optimizedCheckout-header">
        <div class="checkoutHeader-content">
            <h1 class="is-srOnly">{{lang 'checkout.title'}}</h1>
            <h2 class="checkoutHeader-heading">
                <a class="checkoutHeader-link" href="{{urls.home}}">
                    {{#if checkout.header_image}}
                        <img alt="{{settings.store_logo.title}}" class="checkoutHeader-logo" id="logoImage" src="{{ checkout.header_image }}"/>
                    {{ else }}
                        <span class="header-logo-text">{{settings.store_logo.title}}</span>
                    {{/if}}
                </a>
            </h2>
        </div>
    </header>
    
    {{{ checkout.order_confirmation_content }}}
    
    {{{ footer.scripts }}}
{{/partial}}

{{> layout/empty}}
