{{#partial "head"}}

{{{ checkout.checkout_head }}}
{{{ stylesheet '/assets/css/optimized-checkout.css' }}}
{{ getFontsCollection }}

<script type="text/javascript">
    window.language = {{{langJson 'optimized_checkout'}}};
</script>

{{!-- START OLS CUSTOMIZATION - Injection - Custom Checkout Script Integration --}}
<script async src="{{cdn 'assets/dist/theme-bundle.checkout.js'}}"></script>
{{!-- END OLS CUSTOMIZATION --}}

{{!-- START OLS CUSTOMIZATION - Feature - Windows Object - Checkout --}}
{{> _ols/components/window-object/ols-window-checkout }}
{{!-- END OLS CUSTOMIZATION --}}

{{!-- START OLS CUSTOMIZATION - Feature - Google Datalayer - Checkout --}}
{{> _ols/components/integrations/google/ols-google-datalayer }}
{{!-- END OLS CUSTOMIZATION --}}

{{!-- START OLS CUSTOMIZATION - Feature - Google Datalayer - Pagetype - [Checkout] --}}
{{> _ols/components/integrations/google/ols-google-datalayer-pagetype-checkout}}
{{!-- END OLS CUSTOMIZATION --}}

{{!-- START OLS CUSTOMIZATION - Feature - Convert --}}
{{> _ols/components/integrations/convert/ols-convert-advanced-tracking }}
{{!-- END OLS CUSTOMIZATION --}}

{{{head.scripts}}}

{{/partial}}

{{#partial "page"}}
{{!-- START OLS CUSTOMIZATION - Feature - Google Tag Manager - Checkout - [GMT] --}}
    {{> _ols/components/integrations/google/ols-google-tag-manager }}
{{!-- END OLS CUSTOMIZATION --}}

<header class="checkoutHeader optimizedCheckout-header">
    <div class="checkoutHeader-content">
        <h1 class="is-srOnly">{{lang 'checkout.title'}}</h1>
        <h2 class="checkoutHeader-heading">
            <a class="checkoutHeader-link" href="{{urls.home}}">
                {{#if checkout.header_image}}
                    <img alt="{{settings.store_logo.title}}" class="checkoutHeader-logo" id="logoImage" src="{{ checkout.header_image }}"/>
                {{ else }}
                    <span class="header-logo-text">{{settings.store_logo.title}}</span>
                {{/if}}
            </a>
        </h2>
    </div>
</header>

{{{ checkout.checkout_content }}}

{{{ footer.scripts }}}

{{/partial}}

{{> layout/empty}}
